# ============================================================
# SIGEPSI - Variables de Entorno (.env)
# ============================================================
# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir .env al repositorio (ya está en .gitignore).
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=sigepsi-insecure-key-django-sprint0-dev-2026-very-secret
DJANGO_DEBUG=True

# --- Base de Datos PostgreSQL ---
DB_NAME=sigepsi_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Email SMTP (Gmail) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_de_gmail
DEFAULT_FROM_EMAIL=SIGEPSI <tu_correo@gmail.com>

# --- URL del Frontend (para links en emails de recuperación) ---
FRONTEND_URL=http://localhost:4200

# Secret used to encrypt the audit log files. Keep this value private and stable.
AUDIT_LOG_KEY=replace-with-a-long-unique-secret

# --- Stripe (Pasarela de Pagos - Punto 7+8) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --- CU12 / HU-43: Recordatorios push FCM ---
# Cron embebido al usar `runserver` (en producción usar cron/Celery con: python manage.py despachar_recordatorios_push)
RECORDATORIOS_AUTOMATICOS=True
RECORDATORIOS_INTERVALO_SEG=60
# Vacío = modo SANDBOX. Para FCM real: ruta al JSON de cuenta de servicio de Firebase (+ pip install firebase-admin)
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=sigepsi-sandbox

# --- CU21 / HU-47: Clasificación IA del motivo de consulta (Hugging Face) ---
# Modelo zero-shot multilingüe; se descarga (~1.1 GB) la primera vez a HF_HOME.
# Precargar/verificar: python manage.py precargar_modelo_ia
IA_MODELO_HF=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# False = solo respaldo por reglas (modelo_ia='REGLAS-FALLBACK'); útil en tests y equipos sin RAM.
IA_HABILITADA=True
# HF_HOME=/app/.hf_cache
